        {
          "name": "Crear clientes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/clientes",
            "description": "Manual: usar prefijo PRUEBA_LOGOS_. Configurar campos según /schema. Guardar el ID devuelto para este registro nuevo.",
