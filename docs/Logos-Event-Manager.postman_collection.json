      "name": "Manual · Asignaciones de evento",
      "item": [
        {
          "name": "Asignar recurso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/eventos/{{eventos_id}}/recursos/{{recurso}}",
            "description": "Usar campos reales de la tabla intermedia sin FK al evento. Recurso: servicios, empleados o proveedores.",
            "body": {
              "mode": "raw",
              "raw": "{{asignacion_body}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Editar asignación",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/eventos/{{eventos_id}}/recursos/{{recurso}}",
            "description": "key incluye todas las PK reales; values omite PK y FK al evento.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": {{asignacion_key}},\n  \"values\": {{asignacion_body}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Retirar recurso",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/eventos/{{eventos_id}}/recursos/{{recurso}}",
            "description": "Destructiva y manual: elimina solo la asignación identificada dentro del evento indicado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": {{asignacion_key}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
